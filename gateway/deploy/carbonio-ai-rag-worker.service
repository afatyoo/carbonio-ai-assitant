[Unit]
Description=Carbonio AI Assistant Private RAG Worker
After=network-online.target postgresql.service carbonio-ai-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=carbonio-ai
Group=carbonio-ai
WorkingDirectory=/var/lib/carbonio-ai-assistant
Environment=NODE_ENV=production
Environment=AI_RAG_ROLE=worker
EnvironmentFile=-/etc/carbonio-ai-assistant/gateway.env
ExecStart=/opt/carbonio-ai-assistant/runtime/node-v22.22.0-linux-x64/bin/node /opt/carbonio-ai-assistant/gateway/src/rag-worker.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/carbonio-ai-assistant
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
