[Unit]
Description=Carbonio AI Assistant Gateway
After=network-online.target carbonio-appserver.service
Wants=network-online.target

[Service]
Type=simple
User=carbonio-ai
Group=carbonio-ai
WorkingDirectory=/var/lib/carbonio-ai-assistant
Environment=NODE_ENV=production
Environment=PORT=8787
Environment=CARBONIO_SOAP_URL=https://127.0.0.1:8443/service/soap
EnvironmentFile=-/etc/carbonio-ai-assistant/gateway.env
ExecStart=/opt/carbonio-ai-assistant/runtime/node-v22.22.0-linux-x64/bin/node /opt/carbonio-ai-assistant/gateway/src/server.js
Restart=on-failure
RestartSec=3
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/carbonio-ai-assistant
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
