[Unit]
Description=Carbonio AI Assistant Isolated Restore Drill
After=network-online.target postgresql.service carbonio-ai-backup.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/carbonio-ai-assistant/bin/restore-drill.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/carbonio-ai-assistant
