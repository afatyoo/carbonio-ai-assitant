PORT=8787
CARBONIO_SOAP_URL=https://127.0.0.1:8443/service/soap
CARBONIO_SOAP_TIMEOUT_MS=20000
# Optional file-backed secret. Production packages can use the systemd credential helper.
AI_AGENT_API_KEY_FILE=
AI_PROVIDER_TIMEOUT_MS=75000
AI_PROVIDER_CIRCUIT_FAILURES=5
AI_PROVIDER_CIRCUIT_COOLDOWN_MS=30000
AI_MAX_OUTPUT_CHARACTERS=50000
AI_KNOWLEDGE_LIMIT=4
# Optional. Defaults to .runtime/audit.sqlite under the service working directory.
AI_AUDIT_DB_PATH=
AI_DEFAULT_TIMEZONE=Asia/Jakarta

# Production history storage. Keep empty only for local SQLite development.
AI_DATABASE_URL=
AI_DATABASE_POOL_SIZE=10
AI_DATABASE_SSL=false
AI_HISTORY_ENCRYPTION_KEY=
AI_DELETED_HISTORY_RETENTION_DAYS=30

# User-only private RAG. PostgreSQL is required. Run setup-rag-postgres.sh for pgvector.
AI_RAG_DATABASE_POOL_SIZE=6
AI_RAG_WORKER_DATABASE_URL=
AI_RAG_WORKER_POLL_MS=1000
AI_RAG_RELEVANCE_THRESHOLD=0.35
AI_RAG_MAIL_LIMIT=500
# Optional self-hosted OpenAI-compatible embedding endpoint. Empty uses local deterministic vectors.
AI_RAG_EMBEDDING_URL=
AI_RAG_EMBEDDING_MODEL=
AI_RAG_EMBEDDING_HOSTS=127.0.0.1,localhost,::1

# Production policy. AI_ADMIN_ACCOUNTS accepts Carbonio account IDs or email names.
AI_ENABLED=true
AI_ADMIN_ACCOUNTS=admin@example.com
# Optional pilot/feature-flag allowlists. Empty means all authenticated accounts.
AI_ENABLED_ACCOUNTS=
AI_WRITE_TOOL_ACCOUNTS=
AI_PROVIDER_ALLOWLIST=openrouter
# Verify current availability through OpenRouter /api/v1/endpoints/zdr before rollout.
AI_MODEL_ALLOWLIST=inclusionai/ling-3.0-flash:free
AI_REQUESTS_PER_MINUTE=30
AI_REQUESTS_PER_DAY=500
AI_TOKENS_PER_DAY=250000
AI_WRITE_TOOLS_ENABLED=true
# Optional scoped policies. Precedence: account, Carbonio distribution-list group,
# domain, then *. Values are allowlists. Keep empty to use the global settings above.
AI_MODEL_POLICY_JSON=
AI_TOOL_PERMISSION_POLICY_JSON=
AI_GROUP_CACHE_TTL_MS=300000
# Comma-separated full origins permitted in addition to the proxied Webmail origin.
AI_ALLOWED_ORIGINS=
# Custom endpoints are fail-closed. Enable both settings only for trusted HTTPS hosts.
AI_ALLOW_CUSTOM_ENDPOINT=false
AI_CUSTOM_ENDPOINT_HOSTS=

# Optional. Without this URL the gateway stays in local demo-agent mode.
AI_AGENT_URL=
AI_AGENT_API_KEY=
AI_AGENT_MODEL=inclusionai/ling-3.0-flash:free
AI_AGENT_PROVIDER=openrouter
# OpenRouter privacy routing is enforced per request unless explicitly disabled.
AI_OPENROUTER_DENY_DATA_COLLECTION=true
AI_OPENROUTER_ZDR=true
