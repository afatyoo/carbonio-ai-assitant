{
	"name": "carbonio-ai-assistant-ui",
	"version": "1.0.2",
	"description": "Standalone AI assistant microfrontend for Carbonio",
	"license": "MIT",
	"main": "src/app.tsx",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": "v22",
		"pnpm": ">=10"
	},
	"browserslist": [
		"last 2 Chrome versions",
		"last 2 Firefox versions",
		"last 2 Edge versions",
		"last 2 Safari versions"
	],
	"scripts": {
		"build": "sdk build",
		"lint": "eslint --ext .ts,.tsx src",
		"package:release": "bash deploy/package-release.sh",
		"self-test:deploy": "node deploy/self-test-smoke.mjs",
		"self-test:i18n": "node scripts/self-test-i18n.mjs",
		"self-test:release": "node scripts/self-test-release-report.mjs",
		"self-test:ui": "node scripts/self-test-ui-contract.mjs && node scripts/self-test-appointment-result.mjs && node scripts/self-test-action-confirmation.mjs && node scripts/self-test-agent-stream.mjs && node scripts/self-test-plain-text-answer.mjs",
		"start": "sdk watch",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@zextras/carbonio-design-system": "12.0.4",
		"@zextras/carbonio-shell-ui": "15.1.2",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@babel/plugin-transform-runtime": "7.29.7",
		"@babel/preset-env": "7.29.7",
		"@babel/preset-react": "7.29.7",
		"@babel/preset-typescript": "7.29.7",
		"@babel/runtime": "^7.29.7",
		"@emotion/babel-plugin": "11.13.5",
		"@typescript-eslint/eslint-plugin": "6.21.0",
		"@typescript-eslint/parser": "6.21.0",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"@zextras/carbonio-ui-configs": "2.1.0",
		"@zextras/carbonio-ui-sdk": "1.8.0-beta.2",
		"copy-webpack-plugin": "13.0.1",
		"eslint": "8.57.1",
		"eslint-plugin-react-hooks": "4.6.2",
		"eslint-plugin-unused-imports": "3.2.0",
		"typescript": "5.9.3"
	},
	"carbonio": {
		"name": "carbonio-ai-assistant-ui",
		"priority": 15,
		"type": "carbonio",
		"display": "AI Assistant",
		"icon": "MessageCircleOutline"
	}
}
