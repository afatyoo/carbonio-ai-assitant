{
	"name": "carbonio-ai-assistant-ui",
	"version": "0.0.3-dev.11",
	"description": "Standalone AI assistant microfrontend for Carbonio",
	"license": "MIT",
	"main": "src/app.tsx",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": "v22",
		"pnpm": ">=10"
	},
	"scripts": {
		"build": "sdk build",
		"package:release": "bash deploy/package-release.sh",
		"start": "sdk watch",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@zextras/carbonio-design-system": "12.0.4",
		"@zextras/carbonio-shell-ui": "15.1.0",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@babel/plugin-transform-runtime": "7.29.7",
		"@babel/preset-env": "7.29.7",
		"@babel/preset-react": "7.29.7",
		"@babel/preset-typescript": "7.29.7",
		"@babel/runtime": "^7.29.7",
		"@emotion/babel-plugin": "11.13.5",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"@zextras/carbonio-ui-configs": "2.1.0",
		"@zextras/carbonio-ui-sdk": "1.8.0-beta.2",
		"copy-webpack-plugin": "13.0.1",
		"typescript": "5.9.3"
	},
	"carbonio": {
		"name": "carbonio-ai-assistant-ui",
		"priority": 15,
		"type": "carbonio",
